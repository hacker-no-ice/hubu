{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hubustack-docs",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Make the docs Worker the canonical origin after the one-time migration
  // away from the legacy OpenAI Sites custom-domain record.
  "routes": [
    {
      "pattern": "hubustack.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ANALYTICS_ENABLED": "false",
    "ANALYTICS_ORIGIN": "https://hubustack.dev",
    "ANALYTICS_ACCESS_TEAM_DOMAIN": "",
    "ANALYTICS_ACCESS_AUD": ""
  },
  // Local D1 is available immediately. The deployment preparation script binds
  // an explicitly configured production database, or removes this binding.
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "hubustack-analytics",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "ANALYTICS_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "triggers": { "crons": ["17 3 * * *"] }
}
