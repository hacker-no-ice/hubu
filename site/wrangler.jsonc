{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hubustack-docs",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Keep the current proxied DNS origin as a fallback; this route serves the
  // canonical hostname without requiring a destructive DNS cutover.
  "routes": [
    {
      "pattern": "hubustack.dev/*",
      "zone_name": "hubustack.dev"
    }
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
