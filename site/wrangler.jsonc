{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hubustack-docs",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Make the docs Worker the canonical origin after the one-time migration
  // away from the legacy OpenAI Sites custom-domain record.
  "routes": [
    {
      "pattern": "hubustack.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
